               child: const Text("DELETE", style: TextStyle(color: Colors.red))
            ),
            TextButton(
               onPressed: () {
                 final data = {'email': eC.text.trim(), 'password': pC.text, 'role': selectedRole};
                 if(existingDoc == null) FirebaseFirestore.instance.collection('users').add(data);
                 else existingDoc.reference.update(data);
                 Navigator.pop(context);
               }, 
               child: const Text("SAVE")
            ),
          ]
        );
      }
    ));
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text("User Management")),
      body: StreamBuilder<QuerySnapshot>(
        stream: FirebaseFirestore.instance.collection('users').snapshots(),
        builder: (context, snap) {
           if (!snap.hasData) return const Center(child: CircularProgressIndicator());
           return ListView.builder(
             itemCount: snap.data!.docs.length,
             itemBuilder: (context, index) {
               var doc = snap.data!.docs[index];
               return Card(
                 child: ListTile(
                   leading: CircleAvatar(child: Icon(doc['role'] == 'HOD' ? Icons.star : Icons.person)),
                   title: Text(doc['email']),
                   subtitle: Text("Role: ${doc['role']} | Pass: ${doc['password']}"), // Showing pass only to Admin
                   trailing: const Icon(Icons.edit),
                   onTap: () => _userDialog(context, existingDoc: doc),
                 )
               );
             }
           );
        }
      ),
      floatingActionButton: FloatingActionButton(
        onPressed: () => _userDialog(context),
        child: const Icon(Icons.person_add),
      ),
    );
  }
}
