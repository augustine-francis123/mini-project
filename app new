// --- 3. DASHBOARD WITH LIVE GRAPH ---
class NoiseAlertDashboard extends StatefulWidget {
  final String userRole;
  const NoiseAlertDashboard({super.key, required this.userRole});

  @override
  State<NoiseAlertDashboard> createState() => _NoiseAlertDashboardState();
}

class _NoiseAlertDashboardState extends State<NoiseAlertDashboard> {
  StreamSubscription? _sub;
  int _db = 0;
  bool _isUnlocked = false;
  bool _isPresent = false;
  
  final List<FlSpot> _dataPoints = [];
  double _timeCounter = 0;

  @override
  void initState() {
    super.initState();
    // Fill initial line to avoid empty chart crashes
    for (int i = 0; i < 30; i++) {
        _dataPoints.add(FlSpot(i.toDouble(), 0));
    }
    _timeCounter = 30.0;

    _sub = FirebaseDatabase.instance.ref('classroom_status/S6_CS_B').onValue.listen((event) {
      if (!mounted) return;
      if (event.snapshot.value == null) return;
      final Map data = event.snapshot.value as Map;
      int db = (data['decibels'] ?? 0).toInt();
      
      setState(() {
         _db = db;
         _isUnlocked = data['isUnlocked'] ?? false;
         _isPresent = data['isTeacherPresent'] ?? false;
         
         // Graph Sliding Window Logic
         _dataPoints.add(FlSpot(_timeCounter, db.toDouble()));
         _dataPoints.removeAt(0);
         _timeCounter += 1;
      });
      _runInAppLogic(db, _isUnlocked);
    });
  }

  @override
  void dispose() {
    _sub?.cancel();
    super.dispose();
  }

  void _runInAppLogic(int db, bool isUnlocked) {
    if (isUnlocked || _isBreakTime() || db <= 0) return;
    if (db >= 60 && widget.userRole == "Teacher") {
      Vibration.vibrate(duration: 400);
    }
    if (db >= 80) {
      FirebaseFirestore.instance.collection('management_alerts').add({
        'room': 'S6 CS B', 'level': db, 'timestamp': FieldValue.serverTimestamp(),
      });
    }
  }

  @override
  Widget build(BuildContext context) {
    return Column(
      children: [
        Expanded(
          flex: 4,
          child: Center(
            child: Column(
                mainAxisAlignment: MainAxisAlignment.center,
                children: [
                  if (_isBreakTime()) const Chip(label: Text("BREAK TIME - PAUSED"), backgroundColor: Colors.orangeAccent),
                  const Icon(Icons.graphic_eq, size: 40, color: Colors.blueGrey),
                  Text("$_db dB",
                      style: TextStyle(
                          fontSize: 100,
                          fontWeight: FontWeight.bold,
                          color: _isUnlocked ? Colors.grey : (_db >= 60 ? Colors.red : const Color(0xFF5369E4))
                      )),
                  Chip(
                    backgroundColor: _isPresent ? Colors.green.shade100 : Colors.red.shade100,
                    label: Text(_isPresent ? "FACULTY PRESENT" : "ROOM UNSUPERVISED"),
                  ),
                  if (_isUnlocked) const Text("Alerts Muted by RFID", style: TextStyle(color: Colors.grey)),
                ]
            ),
          ),
        ),
        const Divider(),
        const Padding(
          padding: EdgeInsets.all(8.0),
          child: Text("LIVE NOISE METRICS", style: TextStyle(fontWeight: FontWeight.bold)),
        ),
        Expanded(
          flex: 2,
          child: Padding(
            padding: const EdgeInsets.only(right: 20.0, left: 10, bottom: 20),
            child: LineChart(
              LineChartData(
                minY: 0,
                maxY: 120, // Max DB
                minX: _timeCounter - 30, // Sliding window
                maxX: _timeCounter,
                lineBarsData: [
                  LineChartBarData(
                    spots: _dataPoints,
                    isCurved: true,
                    color: Colors.blueAccent,
                    barWidth: 3,
                    isStrokeCapRound: true,
                    dotData: const FlDotData(show: false),
                    belowBarData: BarAreaData(show: true, color: Colors.blueAccent.withOpacity(0.2)),
                  ),
                ],
                titlesData: const FlTitlesData(
                  topTitles: AxisTitles(sideTitles: SideTitles(showTitles: false)),
                  bottomTitles: AxisTitles(sideTitles: SideTitles(showTitles: false)),
                  rightTitles: AxisTitles(sideTitles: SideTitles(showTitles: false)),
                ),
                gridData: const FlGridData(show: true, drawVerticalLine: false),
                borderData: FlBorderData(show: false),
              ),
            ),
          ),
        )
      ],
    );
  }
}

// --- 4. ALERTS PAGE ---
class AlertsPage extends StatelessWidget {
  const AlertsPage({super.key});

  String _formatDateTime(dynamic timestamp) {
    if (timestamp == null) return "Just now";
    DateTime dt = (timestamp as Timestamp).toDate();
    String hour = dt.hour > 12 ? (dt.hour - 12).toString() : (dt.hour == 0 ? "12" : dt.hour.toString());
    String minute = dt.minute.toString().padLeft(2, '0');
    String ampm = dt.hour >= 12 ? "PM" : "AM";
    const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
    return "${months[dt.month - 1]} ${dt.day}, $hour:$minute $ampm";
  }

  @override
  Widget build(BuildContext context) {
    return StreamBuilder<QuerySnapshot>(
      stream: FirebaseFirestore.instance.collection('management_alerts').orderBy('timestamp', descending: true).limit(20).snapshots(),
      builder: (context, snap) {
        if (!snap.hasData) return const Center(child: CircularProgressIndicator());
        return ListView.builder(
            itemCount: snap.data!.docs.length,
            itemBuilder: (c, i) {
              var data = snap.data!.docs[i].data() as Map<String, dynamic>;
              return Card(
                margin: const EdgeInsets.symmetric(horizontal: 16, vertical: 8),
                child: ListTile(
                  leading: const Icon(Icons.warning, color: Colors.red),
                  title: Text("High Noise: ${data['level']} dB", style: const TextStyle(fontWeight: FontWeight.bold)),
                  subtitle: Text("Room: ${data['room']}\nTime: ${_formatDateTime(data['timestamp'])}"),
                  isThreeLine: true,
                ),
              );
            }
        );
      },
    );
  }
}

// --- 5. TIMETABLE WIDGET (Dynamic & Editable) ---
class TimetableWidget extends StatelessWidget {
  final String userRole;
  const TimetableWidget({super.key, required this.userRole});

  void _addPeriodDialog(BuildContext context, String dayId) {
    final pc = TextEditingController();
    final sc = TextEditingController();
    final fc = TextEditingController();
    showDialog(context: context, builder: (context) => AlertDialog(
      title: Text("Add Period for $dayId"),
      content: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          TextField(controller: pc, decoration: const InputDecoration(labelText: "Period (e.g. 1)")),
          TextField(controller: sc, decoration: const InputDecoration(labelText: "Subject")),
          TextField(controller: fc, decoration: const InputDecoration(labelText: "Faculty Name")),
        ],
      ),
      actions: [
        TextButton(onPressed: ()=>Navigator.pop(context), child: const Text("CANCEL")),
        TextButton(onPressed: () {
          FirebaseFirestore.instance.collection('timetable').doc(dayId).set({
            'periods': FieldValue.arrayUnion([
              {'p': pc.text, 's': sc.text, 'f': fc.text}
            ])
          }, SetOptions(merge: true));
          Navigator.pop(context);
        }, child: const Text("SAVE")),
      ]
    ));
  }

  @override
  Widget build(BuildContext context) {
    bool canEdit = (userRole == "HOD" || userRole == "Teacher");

    return DefaultTabController(
      length: 5,
      child: Column(
        children: [
          const TabBar(
            isScrollable: true,
            labelColor: Color(0xFF5369E4),
            tabs: [Tab(text: "Mon"), Tab(text: "Tue"), Tab(text: "Wed"), Tab(text: "Thu"), Tab(text: "Fri")],
          ),
          Expanded(
            child: TabBarView(
              children: ["Mon", "Tue", "Wed", "Thu", "Fri"].map((day) {
                return StreamBuilder<DocumentSnapshot>(
                  stream: FirebaseFirestore.instance.collection('timetable').doc(day).snapshots(),
                  builder: (context, snapshot) {
                     if(!snapshot.hasData) return const Center(child: CircularProgressIndicator());
                     List periods = [];
                     if(snapshot.data!.exists) {
                       periods = (snapshot.data!.data() as Map)['periods'] ?? [];
                     }

                     return Scaffold(
                        body: ListView.builder(
                          itemCount: periods.length,
                          padding: const EdgeInsets.all(10),
                          itemBuilder: (context, index) {
                            var p = periods[index];
                            return Dismissible(
                              key: UniqueKey(),
                              direction: canEdit ? DismissDirection.endToStart : DismissDirection.none,
                              background: Container(color: Colors.red, alignment: Alignment.centerRight, padding: const EdgeInsets.only(right: 20), child: const Icon(Icons.delete, color: Colors.white)),
                              onDismissed: (dir) {
                                FirebaseFirestore.instance.collection('timetable').doc(day).update({
                                  'periods': FieldValue.arrayRemove([p])
                                });
                              },
                              child: Card(
                                child: ListTile(
                                  leading: CircleAvatar(backgroundColor: const Color(0xFF5369E4), child: Text(p['p'].toString(), style: const TextStyle(color: Colors.white, fontSize: 12))),
                                  title: Text(p['s'].toString(), style: const TextStyle(fontWeight: FontWeight.bold)),
                                  subtitle: Text("Faculty: ${p['f']}"),
                                ),
                              )
                            );
                          }
                        ),
                        floatingActionButton: canEdit 
                          ? FloatingActionButton(onPressed: () => _addPeriodDialog(context, day), child: const Icon(Icons.add)) 
                          : null,
                     );
                  }
                );
              }).toList(),
            ),
          ),
        ],
      ),
    );
  }
}

